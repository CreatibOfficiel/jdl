jdl.thibaud-cb.fr {
	import log_file jdl
	import common_headers
	import gz

	# Colyseus WebSocket + matchmake HTTP — strip /colyseus prefix
	handle_path /colyseus/* {
		reverse_proxy jeu-soiree-server:2567 {
			# Keep WS alive across Caddy reloads on unrelated routes.
			stream_close_delay 5m
			flush_interval -1
		}
	}

	# Next.js (frontend)
	handle {
		reverse_proxy jeu-soiree-web:3000
	}
}
